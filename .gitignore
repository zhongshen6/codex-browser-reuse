# Generated backend state. The sole runtime npm package is distributed in Git.
/logs/
# Recreate adapted startup assets with tools/build-frontend.ps1.
/runtime/frontend-build/
/node_modules/*
!/node_modules/smol-toml/
# Local LAN credentials must never be committed or included in shared source archives.
/config/lan-auth.json

# The packaged renderer is the only required part of the exported frontend.
# Electron build products and its original dependency tree are not loaded.
/runtime/*/.vite/
/runtime/*/node_modules/
/runtime/*/native-menu-locales/
/runtime/*/package.json

# Temporary verification captures are not application assets.
/*.png
/tests/*.png
*.log
# Ignore regenerated Python bytecode from local development tools.
__pycache__/
*.pyc
